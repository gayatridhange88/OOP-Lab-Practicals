    string Name;
    int RollNo;
    long long MobileNo;
    string EmailId;

public:
    student()
    {
        Name = "Gayatri Dhange";
        RollNo = 51;
        MobileNo = 4356758859;
        EmailId = "gayatri23@gmail.com";
    }

    student(string N, int RN, long long MN, string EI)
    {
        Name = N;
